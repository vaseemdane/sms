# Environment Configuration
APP_NAME="EduPulse SMS Backend"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/sms_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://localhost:6380/0
CACHE_DEFAULT_TTL=300

# Security (Change in production!)
JWT_SECRET=super-secret-dev-jwt-key-edupulse-sms-2026-production-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Rate Limits
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_AUTH_PER_MIN=120
